{
  "name": "elite-body-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --watch src/server.ts",
    "dev:preview": "node scripts/dev-preview.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-conventions.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:browser": "playwright test",
    "audit:visual": "node test/visual-audit.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "node --env-file-if-exists=.env node_modules/kanel/bin/kanel --config .kanelrc.cjs",
    "account:provision": "node --env-file-if-exists=.env scripts/provision-account.ts",
    "content:video": "node --env-file-if-exists=.env scripts/set-video.ts",
    "onboarding:admin": "node --env-file-if-exists=.env scripts/onboarding-admin.ts",
    "mentor:admin": "node --env-file-if-exists=.env scripts/mentor-admin.ts",
    "verify": "npm run db:migrate && npm run db:generate && npm run lint && npm run typecheck && npm run build && npm test && npm run test:browser",
    "management:admin": "node --env-file-if-exists=.env scripts/management-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "kysely": "0.28.17",
    "lit-html": "3.3.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "kanel": "3.16.1",
    "kanel-kysely": "0.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
