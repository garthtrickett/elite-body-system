DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elite_body_system
PUBLIC_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_KEY=
# Local only: .data/outbox/*.json contains real bearer links; never commit or expose it.
EMAIL_MODE=outbox
# For production: EMAIL_MODE=resend, HTTPS PUBLIC_ORIGIN, and your own verified sender.
EMAIL_FROM=
RESEND_API_KEY=

# Optional: server-only meal analysis with OpenAI gpt-6-luna. Manual meals work without it.
OPENAI_API_KEY=

# Temporary shared preview login: harrybaldwin. Off by default.
# Enable only after explicitly provisioning harrybaldwin@preview.invalid.
AUTH_HARRY_PREVIEW=false
