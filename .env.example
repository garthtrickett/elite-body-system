DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elite_body_system
PUBLIC_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_KEY=
# Local only: .data/outbox/*.json contains real bearer links; never commit or expose it.
EMAIL_MODE=outbox
# For production: EMAIL_MODE=resend, HTTPS PUBLIC_ORIGIN, and your own verified sender.
EMAIL_FROM=
RESEND_API_KEY=

# Optional: server-only meal analysis with OpenAI gpt-6-luna. Manual meals work without it.
OPENAI_API_KEY=

# Temporary shared preview login: harrybaldwin. Off by default.
# Enable only after explicitly provisioning harrybaldwin@preview.invalid.
AUTH_HARRY_PREVIEW=false

# New eight-section onboarding. Enable only after approved content and integrations
# pass acceptance. When enabled, ALL clients must complete harry-v2.
ONBOARDING_ENABLED=false
# Saturday Body check-in. App access is locked while the current week is due.
# Scheduling uses the client's enrolled time zone; no external messaging is sent.
CHECKINS_ENABLED=true
CHECKIN_HOUR=9
# Private S3-compatible storage; all five values are required together.
ASSESSMENT_S3_ENDPOINT=
ASSESSMENT_S3_REGION=
ASSESSMENT_S3_BUCKET=
ASSESSMENT_S3_ACCESS_KEY_ID=
ASSESSMENT_S3_SECRET_ACCESS_KEY=
# false for new Railway buckets; true for path-style providers/local S3 tests.
ASSESSMENT_S3_FORCE_PATH_STYLE=true
# Read-only Google Calendar confirmation; all four values are required together.
# The scheduling integration must bind events using private ebsAccountId metadata.
ONBOARDING_GOOGLE_CALENDAR_ID=
ONBOARDING_GOOGLE_CLIENT_ID=
ONBOARDING_GOOGLE_CLIENT_SECRET=
ONBOARDING_GOOGLE_REFRESH_TOKEN=
